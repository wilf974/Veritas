;; JOSEPH (LE SONGE) - Generateur de claims Pentecotees
;; Auteur: Wilfred Maillot
;; Date: 2026-05-07
;;
;; Genese 41:15-16 - "Pharaon dit a Joseph : J'ai eu un songe, et il n'y a personne
;;                    pour l'expliquer. Joseph repondit : Ce n'est pas moi.
;;                    Dieu donnera a Pharaon une reponse favorable."
;;
;; Joseph est l'INVERSE algorithmique de Daniel :
;;   - Daniel lit MENE TEKEL PHARES sur le mur (verifie a posteriori)
;;   - Joseph predit la famine avant qu'elle vienne (genere a priori)
;;
;; Joseph compose avec PENTECOTE :
;;   dream(expr, prop_partial)         -> claim Pentecotee Parfaite
;;   interpret_dream(claim)            -> diagnostic (0 ou 1..13)
;;
;; Round-trip garanti : pour tout expr et tout prop_partial bien forme,
;;   pentecote_verdict(dream(expr, prop_partial)) = "PENTECOTEE PARFAITE"


;; ===================================================================
;; SECTION 1 : Helpers MTP (heritage)
;; ===================================================================

(@intent "Reducer somme operandes.")
(fn add_if_operand ((acc num) (tok num)) num
  (if (< tok 1001) (+ acc tok) acc))

(@intent "Somme des operandes (tokens < 1001).")
(@example (list 3 4 1001 5 1003) 12)
(@example (list 2 10 1006) 12)
(@example (list 7 0 1001) 7)
(@example (list 100 7 1005) 107)
(@example (list 5) 5)
(@example (list 3 4 1001 5 2 1002 1003 16 1101 1001) 30)
(fn sum_operands ((expr list)) num
  (reduce:list add_if_operand expr 0))

(@intent "Reducer compte operateurs.")
(fn inc_if_operator ((acc num) (tok num)) num
  (if (>= tok 1001) (+ acc 1) acc))

(@intent "Nombre d'operateurs (tokens >= 1001).")
(@example (list 3 4 1001) 1)
(@example (list 3 4 1001 5 1003) 2)
(@example (list 5) 0)
(@example (list 3 4 1001 5 2 1002 1003 16 1101 1001) 5)
(fn count_operators ((expr list)) num
  (reduce:list inc_if_operator expr 0))

(@intent "Division entiere securisee.")
(fn safe_div ((a num) (b num)) num
  (if (= b 0) -999999 (floor (/ a b))))

(@intent "Modulo securise.")
(fn safe_mod ((a num) (b num)) num
  (if (= b 0) -999999 (% a b)))

(@intent "Operateur binaire avec propagation sentinelle.")
(fn apply_binary ((op num) (a num) (b num)) num
  (if (= a -999999) -999999 (if (= b -999999) -999999
      (if (= op 1001) (+ a b) (if (= op 1002) (- a b) (if (= op 1003) (* a b)
      (if (= op 1004) (call safe_div a b) (if (= op 1005) (call safe_mod a b)
      (if (= op 1006) (math:pow a b) (if (= op 1009) (min a b) (if (= op 1010) (max a b) -999999)))))))))))

(@intent "Operateur unaire avec propagation sentinelle.")
(fn apply_unary ((op num) (a num)) num
  (if (= a -999999) -999999
    (if (= op 1101) (math:sqrt a) (if (= op 1102) (math:abs a) -999999))))

(@intent "Reducer une etape stack.")
(fn tekel_step ((stack list) (tok num)) list
  (if (< tok 1001) (concat stack (list tok))
    (if (>= tok 1100)
      (if (< (len stack) 1) (list -999999)
        (concat (slice stack 0 (- (len stack) 1))
                (list (call apply_unary tok (get stack (- (len stack) 1))))))
      (if (< (len stack) 2) (list -999999)
        (concat (slice stack 0 (- (len stack) 2))
                (list (call apply_binary tok (get stack (- (len stack) 2)) (get stack (- (len stack) 1)))))))))

(@intent "Evaluation RPN complete.")
(@example (list 3 4 1001) 7)
(@example (list 3 4 1001 5 1003) 35)
(@example (list 2 10 1006) 1024)
(@example (list 7 0 1001) 7)
(@example (list 100 7 1005) 2)
(@example (list 5) 5)
(@example (list 3 4 1001 5 2 1002 1003 16 1101 1001) 25)
(fn tekel_weigh ((expr list)) num
  (get (reduce:list tekel_step expr (list)) 0))


;; ===================================================================
;; SECTION 2 : Helpers JOSEPH (calculs predictifs)
;; ===================================================================

(@intent "Calcule les 8 temoins (M, T, P2, P3, P5, P7, P11, P13) pour une expression.")
(@example (list 3 4 1001 5 1003) (list 5 2 1 2 0 0 2 9))
(@example (list 2 10 1006) (list 5 1 0 1 4 2 1 10))
(@example (list 7 0 1001) (list 0 1 1 1 2 0 7 7))
(@example (list 100 7 1005) (list 2 1 0 2 2 2 2 2))
(@example (list 5) (list 5 0 1 2 0 5 5 5))
(@example (list 3 4 1001 5 2 1002 1003 16 1101 1001) (list 2 5 1 1 0 4 3 12))
(fn compute_witnesses ((expr list)) list
  (list
    (% (call sum_operands expr) 7)
    (% (call count_operators expr) 7)
    (% (call tekel_weigh expr) 2)
    (% (call tekel_weigh expr) 3)
    (% (call tekel_weigh expr) 5)
    (% (call tekel_weigh expr) 7)
    (% (call tekel_weigh expr) 11)
    (% (call tekel_weigh expr) 13)))

(@intent "Hash des 8 temoins (M+T+P2+P3+P5+P7+P11+P13) mod 7.")
(@example (list 5 2 1 2 0 0 2 9) 0)
(@example (list 5 1 0 1 4 2 1 10) 3)
(@example (list 0 1 1 1 2 0 7 7) 5)
(@example (list 2 1 0 2 2 2 2 2) 6)
(@example (list 5 0 1 2 0 5 5 5) 2)
(@example (list 2 5 1 1 0 4 3 12) 0)
(fn fhash_of ((witnesses list)) num
  (% (+ (get witnesses 0) (get witnesses 1)
        (get witnesses 2) (get witnesses 3)
        (get witnesses 4) (get witnesses 5)
        (get witnesses 6) (get witnesses 7))
     7))

(@intent "Somme des 6 premiers features de la proposition partielle.")
(@example (list 12 3 1 15 5 0) 36)
(@example (list 0 0 0 0 0 0) 0)
(@example (list 12 3 0 7 5 0) 27)
(@example (list 1 1 1 1 1 1) 6)
(fn sum_partial ((p list)) num
  (+ (get p 0) (get p 1) (get p 2) (get p 3) (get p 4) (get p 5)))

(@intent "Calcule i6 cross-linke : (sum partial + fhash) mod 7.")
(@example (list 12 3 1 15 5 0) 0 1)
(@example (list 12 3 1 15 5 0) 3 4)
(@example (list 12 3 1 15 5 0) 5 6)
(@example (list 12 3 1 15 5 0) 6 0)
(@example (list 12 3 1 15 5 0) 2 3)
(fn compute_i6 ((prop_partial list) (fhash num)) num
  (% (+ (call sum_partial prop_partial) fhash) 7))


;; ===================================================================
;; SECTION 3 : DREAM() - le generateur principal
;; ===================================================================

(@intent "JOSEPH dream() : genere une claim Pentecotee Parfaite a partir de l'expression et d'une proposition partielle.")
(@example (list 3 4 1001 5 1003) (list 12 3 1 15 5 0)
          (list 3 4 1001 5 1003 5 2 1 2 0 0 2 9 12 3 1 15 5 0 1))
(@example (list 2 10 1006) (list 12 3 1 15 5 0)
          (list 2 10 1006 5 1 0 1 4 2 1 10 12 3 1 15 5 0 4))
(@example (list 7 0 1001) (list 12 3 1 15 5 0)
          (list 7 0 1001 0 1 1 1 2 0 7 7 12 3 1 15 5 0 6))
(@example (list 100 7 1005) (list 12 3 1 15 5 0)
          (list 100 7 1005 2 1 0 2 2 2 2 2 12 3 1 15 5 0 0))
(@example (list 5) (list 12 3 1 15 5 0)
          (list 5 5 0 1 2 0 5 5 5 12 3 1 15 5 0 3))
(@example (list 3 4 1001 5 2 1002 1003 16 1101 1001) (list 12 3 1 15 5 0)
          (list 3 4 1001 5 2 1002 1003 16 1101 1001 2 5 1 1 0 4 3 12 12 3 1 15 5 0 1))
(fn dream ((expr list) (prop_partial list)) list
  (concat
    (concat expr (call compute_witnesses expr))
    (concat prop_partial
            (list (call compute_i6 prop_partial (call fhash_of (call compute_witnesses expr)))))))


;; ===================================================================
;; SECTION 4 : Pentecote infrastructure (pour auto-test)
;; ===================================================================

(@intent "Extrait l'expression d'une claim (len-15 premiers tokens).")
(fn expr_part ((c list)) list (slice c 0 (- (len c) 15)))

(@intent "Extrait la proposition (les 7 derniers tokens).")
(fn claim_proposition ((c list)) list (slice c (- (len c) 7) (len c)))

(@intent "Temoin M.") (fn witness_M ((c list)) num (get c (- (len c) 15)))
(@intent "Temoin T.") (fn witness_T ((c list)) num (get c (- (len c) 14)))
(@intent "Temoin P2.") (fn witness_P_2 ((c list)) num (get c (- (len c) 13)))
(@intent "Temoin P3.") (fn witness_P_3 ((c list)) num (get c (- (len c) 12)))
(@intent "Temoin P5.") (fn witness_P_5 ((c list)) num (get c (- (len c) 11)))
(@intent "Temoin P7.") (fn witness_P_7 ((c list)) num (get c (- (len c) 10)))
(@intent "Temoin P11.") (fn witness_P_11 ((c list)) num (get c (- (len c) 9)))
(@intent "Temoin P13.") (fn witness_P_13 ((c list)) num (get c (- (len c) 8)))

(@intent "Valeur evaluee de la formule de la claim.")
(fn formula_value ((c list)) num (call tekel_weigh (call expr_part c)))

;; --- 12 apotres ---

(fn apostle_pierre ((c list)) bool (= (% (call formula_value c) 2) (call witness_P_2 c)))
(fn apostle_andre ((c list)) bool (= (% (call formula_value c) 3) (call witness_P_3 c)))
(fn apostle_jacques_zebedee ((c list)) bool (= (% (call formula_value c) 5) (call witness_P_5 c)))
(fn apostle_jean ((c list)) bool (= (% (call formula_value c) 7) (call witness_P_7 c)))
(fn apostle_philippe ((c list)) bool (= (% (call formula_value c) 11) (call witness_P_11 c)))
(fn apostle_barthelemy ((c list)) bool (= (% (call formula_value c) 13) (call witness_P_13 c)))
(fn apostle_thomas ((c list)) bool (> (get (call claim_proposition c) 0) 0))
(fn apostle_matthieu ((c list)) bool (>= (get (call claim_proposition c) 1) 2))
(fn apostle_jacques_alphee ((c list)) bool (= (get (call claim_proposition c) 2) 1))
(fn apostle_thaddee ((c list)) bool (= (get (call claim_proposition c) 3) 15))
(fn apostle_simon ((c list)) bool (>= (get (call claim_proposition c) 4) 5))
(fn apostle_mathias ((c list)) bool (< (get (call claim_proposition c) 5) 6))

(@intent "Hash de la formule (M+T+P2+P3+P5+P7+P11+P13) mod 7.")
(fn formula_hash ((c list)) num
  (% (+ (call witness_M c) (call witness_T c)
        (call witness_P_2 c) (call witness_P_3 c) (call witness_P_5 c)
        (call witness_P_7 c) (call witness_P_11 c) (call witness_P_13 c)) 7))

(@intent "Cross-link : i6 = (sum i0..i5 + fhash) mod 7.")
(fn cross_link_holds ((c list)) bool
  (= (get (call claim_proposition c) 6)
     (% (+ (get (call claim_proposition c) 0) (get (call claim_proposition c) 1)
           (get (call claim_proposition c) 2) (get (call claim_proposition c) 3)
           (get (call claim_proposition c) 4) (get (call claim_proposition c) 5)
           (call formula_hash c)) 7)))

(@intent "Compte les apotres qui attestent (0..12).")
(fn count_amens ((c list)) num
  (+ (if (call apostle_pierre c) 1 0) (if (call apostle_andre c) 1 0)
     (if (call apostle_jacques_zebedee c) 1 0) (if (call apostle_jean c) 1 0)
     (if (call apostle_philippe c) 1 0) (if (call apostle_barthelemy c) 1 0)
     (if (call apostle_thomas c) 1 0) (if (call apostle_matthieu c) 1 0)
     (if (call apostle_jacques_alphee c) 1 0) (if (call apostle_thaddee c) 1 0)
     (if (call apostle_simon c) 1 0) (if (call apostle_mathias c) 1 0)))

(@intent "Verdict Pentecote.")
(fn pentecote_verdict ((c list)) str
  (if (not (call cross_link_holds c)) "BABEL"
    (if (= (call count_amens c) 12) "PENTECOTEE PARFAITE"
      (if (= (call count_amens c) 11) "PENTECOTEE"
        (if (>= (call count_amens c) 8) "DOUTEUSE" "BABEL")))))


;; ===================================================================
;; SECTION 5 : Round-trip tests Joseph -> Pentecote
;; ===================================================================

(@intent "Test round-trip : verdict Pentecote sur la sortie de dream().")
(@example (list 3 4 1001 5 1003) (list 12 3 1 15 5 0) "PENTECOTEE PARFAITE")
(@example (list 2 10 1006) (list 12 3 1 15 5 0) "PENTECOTEE PARFAITE")
(@example (list 7 0 1001) (list 12 3 1 15 5 0) "PENTECOTEE PARFAITE")
(@example (list 100 7 1005) (list 12 3 1 15 5 0) "PENTECOTEE PARFAITE")
(@example (list 5) (list 12 3 1 15 5 0) "PENTECOTEE PARFAITE")
(@example (list 3 4 1001 5 2 1002 1003 16 1101 1001) (list 12 3 1 15 5 0) "PENTECOTEE PARFAITE")
(@invariant (= result "PENTECOTEE PARFAITE"))
(fn round_trip_verdict ((expr list) (prop_partial list)) str
  (call pentecote_verdict (call dream expr prop_partial)))


;; ===================================================================
;; SECTION 6 : INTERPRET_DREAM() - diagnostic d'une claim
;; ===================================================================

(@intent "JOSEPH interprete : retourne 0 si la claim est PARFAITE, sinon l'index 1..12 du premier apotre qui chute, ou 13 si cross-link rompu.")
(@example (list 3 4 1001 5 1003 5 2 1 2 0 0 2 9 12 3 1 15 5 0 1) 0)
;; Pour les apotres 1-6 (numeriques) : corruption d'un temoin change fhash, i6 doit etre recalcule pour que cross-link tienne
(@example (list 3 4 1001 5 1003 5 2 0 2 0 0 2 9 12 3 1 15 5 0 0) 1)
(@example (list 3 4 1001 5 1003 5 2 1 0 0 0 2 9 12 3 1 15 5 0 6) 2)
(@example (list 3 4 1001 5 1003 5 2 1 2 1 0 2 9 12 3 1 15 5 0 2) 3)
(@example (list 3 4 1001 5 1003 5 2 1 2 0 1 2 9 12 3 1 15 5 0 2) 4)
(@example (list 3 4 1001 5 1003 5 2 1 2 0 0 1 9 12 3 1 15 5 0 0) 5)
(@example (list 3 4 1001 5 1003 5 2 1 2 0 0 2 0 12 3 1 15 5 0 6) 6)
;; Pour les apotres 7-12 (structurels) : prop_partial change, fhash reste = 0, i6 = sum_partial mod 7
(@example (list 3 4 1001 5 1003 5 2 1 2 0 0 2 9 0 3 1 15 5 0 3) 7)
(@example (list 3 4 1001 5 1003 5 2 1 2 0 0 2 9 12 1 1 15 5 0 6) 8)
(@example (list 3 4 1001 5 1003 5 2 1 2 0 0 2 9 12 3 0 15 5 0 0) 9)
(@example (list 3 4 1001 5 1003 5 2 1 2 0 0 2 9 12 3 1 7 5 0 0) 10)
(@example (list 3 4 1001 5 1003 5 2 1 2 0 0 2 9 12 3 1 15 4 0 0) 11)
(@example (list 3 4 1001 5 1003 5 2 1 2 0 0 2 9 12 3 1 15 5 6 0) 12)
;; Cross-link rompu : i6 inattendu pour la formule
(@example (list 3 4 1001 5 1003 5 2 1 2 0 0 2 9 12 3 1 15 5 0 6) 13)
(@invariant (>= result 0))
(@invariant (<= result 13))
(fn interpret_dream ((c list)) num
  (if (not (call cross_link_holds c)) 13
    (if (not (call apostle_pierre c)) 1
      (if (not (call apostle_andre c)) 2
        (if (not (call apostle_jacques_zebedee c)) 3
          (if (not (call apostle_jean c)) 4
            (if (not (call apostle_philippe c)) 5
              (if (not (call apostle_barthelemy c)) 6
                (if (not (call apostle_thomas c)) 7
                  (if (not (call apostle_matthieu c)) 8
                    (if (not (call apostle_jacques_alphee c)) 9
                      (if (not (call apostle_thaddee c)) 10
                        (if (not (call apostle_simon c)) 11
                          (if (not (call apostle_mathias c)) 12 0))))))))))))))

(@intent "Round-trip total : dream genere PARFAITE, interpret_dream sur le resultat retourne 0 (aucun defaut).")
(@example (list 3 4 1001 5 1003) (list 12 3 1 15 5 0) 0)
(@example (list 2 10 1006) (list 12 3 1 15 5 0) 0)
(@example (list 7 0 1001) (list 12 3 1 15 5 0) 0)
(@example (list 100 7 1005) (list 12 3 1 15 5 0) 0)
(@example (list 5) (list 12 3 1 15 5 0) 0)
(@example (list 3 4 1001 5 2 1002 1003 16 1101 1001) (list 12 3 1 15 5 0) 0)
(@invariant (= result 0))
(fn round_trip_diagnostic ((expr list) (prop_partial list)) num
  (call interpret_dream (call dream expr prop_partial)))

;; Mane Thekel Phares - Le Verdict du Roi
;; Spec: docs/2026-05-07-mane-thekel-phares-design.md
;; Date: 2026-05-07
;; Auteur: Wilfred Maillot
;;
;; Une formule auto-attestee = (list <tokens-expression> M T P)
;;   tokens-expression : operandes (0..999) + operateurs (1001..1010 binaires, 1101..1199 unaires)
;;   M = (somme operandes) mod 7
;;   T = (nb operateurs) mod 7
;;   P = V mod 7  (V = valeur evaluee par TEKEL)
;;
;; Sentinelle d'erreur : -999999 (stack underflow ou division par zero)

(@intent "Renvoie les len-3 premiers tokens (l'expression sans le triplet de Daniel).")
(@example (list 3 4 1001 5 1003 5 2 0) (list 3 4 1001 5 1003))
(@example (list 5 5 0 5) (list 5))
(@example (list 0 0 0 0) (list 0))
(fn expr_part ((f list)) list
  (slice f 0 (- (len f) 3)))

(@intent "Le 3eme token depuis la fin (temoin M).")
(@example (list 3 4 1001 5 1003 5 2 0) 5)
(@example (list 5 5 0 5) 5)
(fn witness_M ((f list)) num (get f (- (len f) 3)))

(@intent "Le 2eme token depuis la fin (temoin T).")
(@example (list 3 4 1001 5 1003 5 2 0) 2)
(@example (list 5 5 0 5) 0)
(fn witness_T ((f list)) num (get f (- (len f) 2)))

(@intent "Le dernier token (temoin P).")
(@example (list 3 4 1001 5 1003 5 2 0) 0)
(@example (list 5 5 0 5) 5)
(fn witness_P ((f list)) num (get f (- (len f) 1)))

(@intent "Vrai si tok est un operateur (>= 1001).")
(@example 5 false)
(@example 1001 true)
(@example 1101 true)
(@invariant (= result (>= tok 1001)))
(fn is_operator ((tok num)) bool (>= tok 1001))

(@intent "Vrai si tok est un operateur unaire (>= 1100).")
(@example 5 false)
(@example 1001 false)
(@example 1101 true)
(@invariant (= result (>= tok 1100)))
(fn is_unary ((tok num)) bool (>= tok 1100))

(@intent "Reducer pour somme conditionnelle des operandes.")
(@example 0 5 5)
(@example 7 1001 7)
(@example 10 3 13)
(fn add_if_operand ((acc num) (tok num)) num
  (if (< tok 1001) (+ acc tok) acc))

(@intent "Somme des operandes (tokens < 1001) dans une expression RPN.")
(@example (list 3 4 1001) 7)
(@example (list 3 4 1001 5 1003) 12)
(@example (list 5) 5)
(@example (list 25 1101) 25)
(fn sum_operands ((expr list)) num
  (reduce:list add_if_operand expr 0))

(@intent "Reducer pour comptage conditionnel des operateurs.")
(@example 0 5 0)
(@example 0 1001 1)
(@example 3 1101 4)
(fn inc_if_operator ((acc num) (tok num)) num
  (if (>= tok 1001) (+ acc 1) acc))

(@intent "Nombre d'operateurs (tokens >= 1001) dans une expression RPN.")
(@example (list 3 4 1001) 1)
(@example (list 3 4 1001 5 1003) 2)
(@example (list 5) 0)
(@example (list 25 1101) 1)
(@example (list 1 1 1001 1 1001) 2)
(fn count_operators ((expr list)) num
  (reduce:list inc_if_operator expr 0))

(@intent "Phase MANE I : la formule predit-elle correctement la somme des operandes mod 7 ?")
(@example (list 3 4 1001 5 1003 5 2 0) true)
(@example (list 3 4 1001 5 1003 4 2 0) false)
(@example (list 5 5 0 5) true)
(@example (list 7 0 1001 0 1 0) true)
(@invariant (= result (= (call witness_M f) (% (call sum_operands (call expr_part f)) 7))))
(fn mane_I ((f list)) bool
  (= (call witness_M f) (% (call sum_operands (call expr_part f)) 7)))

(@intent "Phase MANE II : la formule predit-elle correctement le nombre d'operateurs mod 7 ?")
(@example (list 3 4 1001 5 1003 5 2 0) true)
(@example (list 3 4 1001 5 1003 5 1 0) false)
(@example (list 1 1 1001 1 1001 3 2 3) true)
(@example (list 5 5 0 5) true)
(@invariant (= result (= (call witness_T f) (% (call count_operators (call expr_part f)) 7))))
(fn mane_II ((f list)) bool
  (= (call witness_T f) (% (call count_operators (call expr_part f)) 7)))

(@intent "Division entiere securisee (floor) : sentinelle si b = 0.")
(@example 6 2 3)
(@example 5 0 -999999)
(@example 100 7 14)
(@example 0 5 0)
(@example 12 4 3)
(fn safe_div ((a num) (b num)) num
  (if (= b 0) -999999 (floor (/ a b))))

(@intent "Modulo securise : sentinelle si b = 0.")
(@example 7 3 1)
(@example 5 0 -999999)
(@example 100 7 2)
(fn safe_mod ((a num) (b num)) num
  (if (= b 0) -999999 (% a b)))

(@intent "Application d'un operateur binaire avec propagation de la sentinelle.")
(@example 1001 3 4 7)
(@example 1002 10 3 7)
(@example 1003 3 4 12)
(@example 1004 6 2 3)
(@example 1004 5 0 -999999)
(@example 1005 100 7 2)
(@example 1006 2 10 1024)
(@example 1009 7 12 7)
(@example 1010 7 12 12)
(@example 1001 -999999 5 -999999)
(@example 1003 5 -999999 -999999)
(fn apply_binary ((op num) (a num) (b num)) num
  (if (= a -999999) -999999
    (if (= b -999999) -999999
      (if (= op 1001) (+ a b)
      (if (= op 1002) (- a b)
      (if (= op 1003) (* a b)
      (if (= op 1004) (call safe_div a b)
      (if (= op 1005) (call safe_mod a b)
      (if (= op 1006) (math:pow a b)
      (if (= op 1009) (min a b)
      (if (= op 1010) (max a b)
                      -999999)))))))))))

(@intent "Application d'un operateur unaire avec propagation de la sentinelle.")
(@example 1101 25 5)
(@example 1101 16 4)
(@example 1102 7 7)
(@example 1102 0 0)
(@example 1101 -999999 -999999)
(fn apply_unary ((op num) (a num)) num
  (if (= a -999999) -999999
    (if (= op 1101) (math:sqrt a)
    (if (= op 1102) (math:abs a)
                    -999999))))

(@intent "Reducer une etape : push operande, applique operateur si possible. Sentinelle si stack underflow.")
(@example (list) 5 (list 5))
(@example (list 3) 4 (list 3 4))
(@example (list 3 4) 1001 (list 7))
(@example (list 25) 1101 (list 5))
(@example (list 16) 1101 (list 4))
(@example (list 3) 1001 (list -999999))
(@example (list) 1101 (list -999999))
(fn tekel_step ((stack list) (tok num)) list
  (if (< tok 1001)
    (concat stack (list tok))
    (if (>= tok 1100)
      (if (< (len stack) 1)
        (list -999999)
        (concat (slice stack 0 (- (len stack) 1))
                (list (call apply_unary tok (get stack (- (len stack) 1))))))
      (if (< (len stack) 2)
        (list -999999)
        (concat (slice stack 0 (- (len stack) 2))
                (list (call apply_binary tok
                            (get stack (- (len stack) 2))
                            (get stack (- (len stack) 1)))))))))

(@intent "Evaluation RPN complete d'une expression : reduce tekel_step puis top du stack.")
(@example (list 3 4 1001) 7)
(@example (list 3 4 1001 5 1003) 35)
(@example (list 2 10 1006) 1024)
(@example (list 25 1101) 5)
(@example (list 3 4 1001 5 2 1002 1003 16 1101 1001) 25)
(@example (list 5 0 1004) -999999)
(@example (list 3 1001) -999999)
(@example (list 5) 5)
(fn tekel_weigh ((expr list)) num
  (get (reduce:list tekel_step expr (list)) 0))

(@intent "Phase PHARES : la formule predit-elle correctement V mod 7, sachant que V doit etre valide ?")
(@example (list 3 4 1001 5 1003 5 2 0) true)
(@example (list 3 4 1001 5 1003 5 2 2) false)
(@example (list 5 0 1004 5 1 0) false)
(@example (list 2 10 1006 5 1 2) true)
(@example (list 5 5 0 5) true)
(@invariant (= result (and (!= (call tekel_weigh (call expr_part f)) -999999)
                           (= (call witness_P f) (% (call tekel_weigh (call expr_part f)) 7)))))
(fn phares ((f list)) bool
  (and (!= (call tekel_weigh (call expr_part f)) -999999)
       (= (call witness_P f) (% (call tekel_weigh (call expr_part f)) 7))))

(@intent "Compte les phases passees sequentiellement (0..4). 4 = formule entierement resolue.")
(@example (list 3 4 1001 5 1003 5 2 0) 4)
(@example (list 5 5 0 5) 4)
(@example (list 2 10 1006 5 1 2) 4)
(@example (list 3 4 1001 5 1003 4 2 0) 0)
(@example (list 3 4 1001 5 1003 5 1 0) 1)
(@example (list 3 1001 3 1 0) 2)
(@example (list 5 0 1004 5 1 0) 2)
(@example (list 3 4 1001 5 1003 5 2 2) 3)
(@invariant (>= result 0))
(@invariant (<= result 4))
(@invariant (if (call mane_I f) (>= result 1) (= result 0)))
(@invariant (if (>= result 2) (call mane_I f) true))
(@invariant (if (>= result 3) (call mane_II f) true))
(@invariant (if (= result 4) (call phares f) true))
(fn phases_passed ((f list)) num
  (if (not (call mane_I f)) 0
    (if (not (call mane_II f)) 1
      (if (= (call tekel_weigh (call expr_part f)) -999999) 2
        (if (not (call phares f)) 3
                                  4)))))

(@intent "Predicat global : la formule est-elle resolue (4 phases passees) ?")
(@example (list 3 4 1001 5 1003 5 2 0) true)
(@example (list 5 5 0 5) true)
(@example (list 3 4 1001 5 1003 5 2 2) false)
(@example (list 3 1001 3 1 0) false)
(@invariant (= result (= (call phases_passed f) 4)))
(fn is_resolved ((f list)) bool
  (= (call phases_passed f) 4))

(@intent "Resout la formule : retourne V si resolue, sinon sentinelle -999999.")
(@example (list 3 4 1001 5 1003 5 2 0) 35)
(@example (list 5 5 0 5) 5)
(@example (list 2 10 1006 5 1 2) 1024)
(@example (list 3 4 1001 5 2 1002 1003 16 1101 1001 2 5 4) 25)
(@example (list 3 4 1001 5 1003 5 2 2) -999999)
(@example (list 3 1001 3 1 0) -999999)
(@invariant (if (call is_resolved f) (!= result -999999) (= result -999999)))
(fn solve ((f list)) num
  (if (call is_resolved f)
    (call tekel_weigh (call expr_part f))
    -999999))

(@intent "Verdict textuel : 'RESOLUE' ou 'ROMPUE A {phase}'.")
(@example (list 3 4 1001 5 1003 5 2 0) "RESOLUE")
(@example (list 5 5 0 5) "RESOLUE")
(@example (list 2 10 1006 5 1 2) "RESOLUE")
(@example (list 3 4 1001 5 1003 4 2 0) "ROMPUE A MANE I")
(@example (list 3 4 1001 5 1003 5 1 0) "ROMPUE A MANE II")
(@example (list 3 1001 3 1 0) "ROMPUE A TEKEL")
(@example (list 5 0 1004 5 1 0) "ROMPUE A TEKEL")
(@example (list 3 4 1001 5 1003 5 2 2) "ROMPUE A PHARES")
(@invariant (or (str:starts result "RESOLUE") (str:starts result "ROMPUE A ")))
(fn verdict ((f list)) str
  (if (= (call phases_passed f) 4) "RESOLUE"
    (if (= (call phases_passed f) 0) "ROMPUE A MANE I"
    (if (= (call phases_passed f) 1) "ROMPUE A MANE II"
    (if (= (call phases_passed f) 2) "ROMPUE A TEKEL"
                                     "ROMPUE A PHARES")))))
